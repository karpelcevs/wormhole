{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "rubber-duck",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "general": {
      "permissions": [
        { "action": "edit", "resource": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/*", "effect": "ask" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@latest"
  ],
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/Downloads/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/shell/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*/T/opencode/*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh search *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "[ *", "effect": "allow" },
    { "action": "shell", "resource": "true *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "stow --simulate *", "effect": "allow" },
    { "action": "shell", "resource": "opencode debug *", "effect": "allow" },
    { "action": "shell", "resource": "sort *-o *", "effect": "ask" },
    { "action": "shell", "resource": "sort *--output *", "effect": "ask" },
    { "action": "shell", "resource": "*>*", "effect": "ask" },
    { "action": "shell", "resource": "*<*", "effect": "ask" },
    { "action": "edit", "resource": "~/Downloads/*", "effect": "deny" },
    { "action": "edit", "resource": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*/sudo *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git * push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git * reset *--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git * clean *", "effect": "deny" },
    { "action": "shell", "resource": "git branch *-d*", "effect": "deny" },
    { "action": "shell", "resource": "git branch *-D*", "effect": "deny" },
    { "action": "shell", "resource": "git * branch *-d*", "effect": "deny" },
    { "action": "shell", "resource": "git * branch *-D*", "effect": "deny" },
    { "action": "shell", "resource": "brew install *", "effect": "deny" },
    { "action": "shell", "resource": "brew reinstall *", "effect": "deny" },
    { "action": "shell", "resource": "brew upgrade *", "effect": "deny" },
    { "action": "shell", "resource": "npm install *", "effect": "deny" },
    { "action": "shell", "resource": "npm i *", "effect": "deny" },
    { "action": "shell", "resource": "npm ci *", "effect": "deny" },
    { "action": "shell", "resource": "npm add *", "effect": "deny" },
    { "action": "shell", "resource": "npm update *", "effect": "deny" },
    { "action": "shell", "resource": "npm exec *", "effect": "deny" },
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    { "action": "shell", "resource": "pip install *", "effect": "deny" },
    { "action": "shell", "resource": "pip3 install *", "effect": "deny" },
    { "action": "shell", "resource": "python* -m pip install *", "effect": "deny" },
    { "action": "shell", "resource": "opencode upgrade *", "effect": "deny" },
    { "action": "shell", "resource": "opencode update *", "effect": "deny" },
    { "action": "shell", "resource": "opencode plugin add *", "effect": "deny" },
    { "action": "shell", "resource": "opencode plugin update *", "effect": "deny" }
  ]
}
